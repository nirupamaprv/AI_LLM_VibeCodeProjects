      priorityLabel: 'Strong signal',\
      title: `Teach reading productivity \'97 not what to read, but how to read better`,\
      body: `"Summary Magic \'97 Improve Reading Retention" and "Reading Ruler \'97 Are You Using This Kindle Feature?" both earned. Your audience wants to read MORE and retain better, not just be told what to read. Teach the system. You've read 83+ books since 2020 \'97 that system is content gold.`,\
      examples: [\
        `"How I retain 80% of what I read (the system I built in 2023)"`,\
        `"3 Kindle features most readers ignore"`,\
        `"The 15-minute habit that got me to 83 books since 2020"`,\
      ]\
    \},\
    \{\
      num: '4',\
      priority: 'med',\
      priorityLabel: 'Strong signal',\
      title: `Use numbered lists \'97 they've earned $\{numberedTotal > 0 ? '$'+numberedTotal : 'consistently more'\} vs other formats`,\
      body: `Numbered list titles drive the majority of your non-$0 earnings. The number sets a clear expectation and improves click-through. Compare "Sunday Snapshot" ($0 most of the time) vs "3 Data Science Blog Post Ideas" ($2). Same effort to write \'97 completely different reader response.`,\
      examples: [\
        `"5 ways I finally built a consistent writing habit"`,\
        `"3 lessons from running a Women's group at work"`,\
        `"7 books that changed how I think about money"`,\
      ]\
    \},\
    \{\
      num: '5',\
      priority: 'opp',\
      priorityLabel: 'Untapped',\
      title: `Publish honest retros with real numbers \'97 your data is rare and valuable`,\
      body: `"Year of Books 2023 Retro," "30 Articles in 31 Days," and "5 Lessons from Visualizing Audience Growth" all earn because real behind-the-scenes data is scarce. You have years of writing stats, reading stats, and earnings data. Vulnerability + specificity + numbers = posts people finish reading.`,\
      examples: [\
        `"I published 400 posts. Here's what I'd cut if I started over."`,\
        `"5 years of writing data: what the numbers actually say"`,\
        `"How I read 83 books in 4 years around a full-time job and a toddler"`,\
      ]\
    \}\
  ];\
  return recs;\
\}\
\
// \uc0\u9472 \u9472 \u9472  CHART INSTANCES \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
let chartInstances = \{\};\
function destroyCharts() \{\
  Object.values(chartInstances).forEach(c => \{ try \{ c.destroy(); \} catch(e)\{\} \});\
  chartInstances = \{\};\
\}\
\
// \uc0\u9472 \u9472 \u9472  MAIN ANALYSIS \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \u9472 \
async function runAnalysis() \{\
  document.getElementById('loading').style.display = 'flex';\
\
  await new Promise(r => setTimeout(r, 50));\
\
  const parser = new DOMParser();\
  const allPosts = [];\
\
  for (const file of loadedFiles) \{\
    const text = await file.text();\
    const doc = parser.parseFromString(text, 'text/html');\
    const items = doc.querySelectorAll('li.h-entry');\
    items.forEach(li => \{\
      const a = li.querySelector('a');\
      if (!a) return;\
      const title = a.textContent.trim();\
      const raw = li.textContent;\
      const m = raw.match(/\\$([0-9,.]+)/);\
      const earnings = m ? parseFloat(m[1].replace(/,/g,'')) : 0;\
      allPosts.push(\{ title, earnings, url: a.href \});\
    \});\
  \}\
\
  // Deduplicate by title\
  const seen = new Set();\
  const posts = allPosts.filter(p => \{ if (seen.has(p.title)) return false; seen.add(p.title); return true; \});\
\
  // Categorize (exclude Medium meta from earning analysis)\
  const earners = posts.filter(p => p.earnings > 0 && categorize(p.title) !== '__MEDIUM__');\
  const allEarners = posts.filter(p => p.earnings > 0);\
  const totalEarned = posts.reduce((s,p) => s+p.earnings, 0);\
  const mediumEarned = posts.filter(p => p.earnings > 0 && categorize(p.title) === '__MEDIUM__').reduce((s,p)=>s+p.earnings,0);\
  const nonMediumEarned = totalEarned - mediumEarned;\
\
  // Category stats\
  const catStats = \{\};\
  earners.forEach(p => \{\
    const cat = categorize(p.title);\
    if (!catStats[cat]) catStats[cat] = \{ total: 0, count: 0, posts: [] \};\
    catStats[cat].total += p.earnings;\
    catStats[cat].count += 1;\
    catStats[cat].posts.push(p);\
  \});\
\
  // Structure stats\
  const structStats = \{\};\
  earners.forEach(p => \{\
    const s = titleStructure(p.title);\
    if (!structStats[s]) structStats[s] = \{ total: 0, count: 0 \};\
    structStats[s].total += p.earnings;\
    structStats[s].count += 1;\
  \});\
\
  // Dead series\
  const deadSeries = detectSeries(posts);\
\
  renderResults(\{ posts, earners, allEarners, catStats, structStats, deadSeries, totalEarned, nonMediumEarned \});\
\}\
\
function renderResults(\{ posts, earners, allEarners, catStats, structStats, deadSeries, totalEarned, nonMediumEarned \}) \{\
  destroyCharts();\
\
  // KPIs\
  const convRate = posts.length ? Math.round((allEarners.length / posts.length) * 100) : 0;\
  const topPost = [...earners].sort((a,b) => b.earnings - a.earnings)[0];\
  document.getElementById('kpiRow').innerHTML = `\
    <div class="kpi"><div class="kpi-label">Total posts</div><div class="kpi-val">$\{posts.length\}</div></div>\
    <div class="kpi"><div class="kpi-label">Earning posts (non-Medium)</div><div class="kpi-val">$\{earners.length\}</div><div class="kpi-sub">$\{convRate\}% conversion rate</div></div>\
    <div class="kpi"><div class="kpi-label">Non-Medium earnings</div><div class="kpi-val">$$\{nonMediumEarned.toFixed(0)\}</div><div class="kpi-sub">of $$\{totalEarned.toFixed(0)\} total</div></div>\
    <div class="kpi"><div class="kpi-label">Top single post</div><div class="kpi-val">$\{topPost ? '$'+topPost.earnings : '-'\}</div><div class="kpi-sub">$\{topPost ? topPost.title.slice(0,28)+'\'85' : ''\}</div></div>\
  `;\
\
  // Sort cats\
  const sortedCats = Object.entries(catStats).sort((a,b) => b[1].total - a[1].total);\
  const catLabels = sortedCats.map(([c]) => c);\
  const catTotals = sortedCats.map(([,s]) => s.total);\
  const catColors = sortedCats.map(([c]) => CAT_COLORS[c]?.bar || '#B4B2A9');\
\
  // Category chart\
  const catCtx = document.getElementById('catChart').getContext('2d');\
  chartInstances.cat = new Chart(catCtx, \{\
    type: 'bar',\
    data: \{\
      labels: catLabels,\
      datasets: [\{\
        data: catTotals,\
        backgroundColor: catColors,\
        borderRadius: 5,\
        borderSkipped: false,\
      \}]\
    \},\
    options: \{\
      responsive: true,\
      maintainAspectRatio: false,\
      plugins: \{ legend: \{ display: false \}, tooltip: \{ callbacks: \{ label: ctx => ` $$\{ctx.raw\}` \} \} \},\
      scales: \{\
        x: \{ ticks: \{ font: \{ size: 10, family: 'DM Sans' \}, color: '#8a8784', maxRotation: 35 \}, grid: \{ display: false \}, border: \{ display: false \} \},\
        y: \{ ticks: \{ font: \{ size: 10, family: 'DM Sans' \}, color: '#8a8784', callback: v => '$'+v \}, grid: \{ color: '#e8e5de' \}, border: \{ display: false \} \}\
      \}\
    \}\
  \});\
\
  // Structure chart\
  const sLabels = Object.keys(structStats);\
  const sTotals = sLabels.map(l => structStats[l].total);\
  const sCounts = sLabels.map(l => structStats[l].count);\
  const sColors = ['#CECBF6','#9FE1CB','#FAC775','#B4B2A9'];\
  const structCtx = document.getElementById('structChart').getContext('2d');\
  chartInstances.struct = new Chart(structCtx, \{\
    type: 'doughnut',\
    data: \{\
      labels: sLabels.map((l,i) => `$\{l\} ($\{sCounts[i]\} posts)`),\
      datasets: [\{ data: sTotals, backgroundColor: sColors, borderWidth: 0, hoverOffset: 6 \}]\
    \},\
    options: \{\
      responsive: true,\
      maintainAspectRatio: false,\
      plugins: \{\
        legend: \{ position: 'bottom', labels: \{ font: \{ size: 10, family: 'DM Sans' \}, color: '#8a8784', padding: 10, boxWidth: 10, boxHeight: 10 \} \},\
        tooltip: \{ callbacks: \{ label: ctx => ` $$\{ctx.raw\} earned` \} \}\
      \},\
      cutout: '60%'\
    \}\
  \});\
\
  // Avg bars\
  const maxAvg = Math.max(...sortedCats.map(([,s]) => s.total/s.count));\
  document.getElementById('avgBars').innerHTML = sortedCats.map(([cat, s]) => \{\
    const avg = (s.total / s.count).toFixed(2);\
    const pct = Math.round((avg / maxAvg) * 100);\
    const color = CAT_COLORS[cat]?.bar || '#B4B2A9';\
    return `<div class="bar-row">\
      <div class="bar-label">$\{cat\}</div>\
      <div class="bar-track"><div class="bar-fill" style="width:$\{pct\}%;background:$\{color\}"></div></div>\
      <div class="bar-val">$$\{avg\} avg \'b7 $\{s.count\} posts</div>\
    </div>`;\
  \}).join('');\
\
  // Top earners table\
  const topEarners = [...earners].sort((a,b) => b.earnings - a.earnings).slice(0, 15);\
  document.getElementById('earnerRows').innerHTML = topEarners.map(p => \{\
    const cat = categorize(p.title);\
    const style = CAT_COLORS[cat]?.badge || 'background:#edece6;color:#4a4845';\
    return `<tr>\
      <td>$\{p.title\}</td>\
      <td><span class="cat-badge" style="$\{style\}">$\{cat\}</span></td>\
      <td>$$\{p.earnings.toFixed(0)\}</td>\
    </tr>`;\
  \}).join('');\
\
  // Dead series\
  const deadSorted = deadSeries.filter(s => s.count >= 3).sort((a,b) => b.count - a.count);\
  document.getElementById('deadGrid').innerHTML = deadSorted.map(s =>\
    `<div class="dead-card"><div class="dead-name">$\{s.name\}</div><div class="dead-stat">$\{s.count\} posts \'b7 $$\{s.earned.toFixed(0)\} earned total</div></div>`\
  ).join('');\
  const totalDeadPosts = deadSorted.reduce((s,d) => s+d.count, 0);\
  document.getElementById('deadNote').textContent = totalDeadPosts > 0\
    ? `$\{totalDeadPosts\} posts across these series represent significant time investment with minimal return.`\
    : '';\
\
  // Recommendations\
  const recs = generateRecs(catStats, earners, posts);\
  document.getElementById('recsContainer').innerHTML = recs.map(r => \{\
    const ptClass = r.priority === 'high' ? 'pt-high' : r.priority === 'med' ? 'pt-med' : 'pt-opp';\
    return `<div class="rec">\
      <div class="rec-num">$\{r.num\}</div>\
      <div>\
        <div class="rec-title"><span class="priority-tag $\{ptClass\}">$\{r.priorityLabel\}</span>$\{r.title\}</div>\
        <div class="rec-body">$\{r.body\}</div>\
        <div class="rec-examples">$\{r.examples.map(e => `<span class="rec-ex">$\{e\}</span>`).join('')\}</div>\
      </div>\
    </div>`;\
  \}).join('');\
\
  document.getElementById('loading').style.display = 'none';\
  document.getElementById('upload-view').style.display = 'none';\
  document.getElementById('results-view').style.display = 'block';\
  window.scrollTo(0,0);\
\}\
\
function resetTool() \{\
  loadedFiles = [];\
  document.getElementById('filePills').innerHTML = '';\
  document.getElementById('analyzeBtn').style.display = 'none';\
  document.getElementById('fileInput').value = '';\
  document.getElementById('results-view').style.display = 'none';\
  document.getElementById('upload-view').style.display = 'flex';\
  destroyCharts();\
\}\
</script>\
</body>\
</html>}